<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_ilock" model="ir.ui.view">
        <field name="name">stock.picking.form.ilock.inventory</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//group" position="inside">
                <group string="I LOCK Operation Traceability">
                    <field name="ilock_document_ref"/>
                    <field name="ilock_shift"/>
                    <field name="ilock_requested_by"/>
                    <field name="ilock_operation_note"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
