<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_ilock" model="ir.ui.view">
        <field name="name">product.template.form.ilock.inventory</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']//group" position="inside">
                <group string="I LOCK Operational Controls">
                    <field name="ilock_reorder_point"/>
                    <field name="ilock_storage_note"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
